# App
# Canonical public origin. Also used for SEO: metadataBase, absolute OG image
# URLs, robots.txt, and the sitemap. Full origin, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Site origin only (paths in services already start with /api/)
NEXT_PUBLIC_API_URL=http://localhost:3000
ENVIRONMENT=development
# CSRF Origin allowlist for state-changing endpoints (admin writes, login,
# contact, subscribe, analytics/view). Comma-separated origins. Falls back to
# NEXT_PUBLIC_APP_URL + NEXT_PUBLIC_API_URL when unset. Set explicitly in prod
# to include any additional origin (custom domain, staging preview host).
CSRF_ALLOWED_ORIGINS=

# Payload CMS
PAYLOAD_SECRET=change-me-in-production
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Set true in production/staging so editors use custom Kiribe admin only
DISABLE_PAYLOAD_STUDIO=false

# Cloudflare R2 (media storage). When all four core vars below are set, Payload
# stores uploads in R2; otherwise it falls back to local disk (dev only).
# Setup: Cloudflare dashboard → R2 → Create bucket, then "Manage R2 API Tokens"
# → create a token scoped "Object Read & Write" for that bucket.
# Verify with `npm run r2:check` after filling these in.
R2_ACCOUNT_ID=          # R2 → Overview → "Account ID" (also in the S3 endpoint)
R2_ACCESS_KEY_ID=       # from the R2 API token
R2_SECRET_ACCESS_KEY=   # from the R2 API token (shown once)
R2_BUCKET_NAME=         # the bucket name you created, e.g. kiribe-media
# Optional: paste the EXACT S3 endpoint from the bucket's Settings → S3 API
# panel. Required for jurisdiction buckets (e.g. https://<id>.eu.r2.cloudflarestorage.com).
# When set, it overrides the endpoint built from R2_ACCOUNT_ID.
R2_S3_ENDPOINT=
# Public origin used to render images. Either the bucket's r2.dev URL (enable
# "Public Development URL" on the bucket) or a custom domain. Full origin, no
# trailing slash — e.g. https://pub-xxxx.r2.dev or https://media.kiribeonline.com
R2_PUBLIC_URL=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Search Console verification. Optional — set to the meta-tag value from
# Google Search Console (google-site-verification) or Bing Webmaster
# (msvalidate.01). Leave empty and use the DNS TXT method if you prefer.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# AI crawler opt-out. Default is allow — editorial site wants its work cited
# in ChatGPT, Claude, Perplexity, and Google/Bing AI Overviews. Set any of
# these to `true` to disallow a specific bot without editing robots.ts. See
# src/app/robots.ts for the AI_BOTS list.
AI_DISALLOW_GPTBOT=
AI_DISALLOW_OAI_SEARCHBOT=
AI_DISALLOW_CLAUDEBOT=
AI_DISALLOW_CLAUDE_WEB=
AI_DISALLOW_PERPLEXITYBOT=
AI_DISALLOW_GOOGLE_EXTENDED=
AI_DISALLOW_CCBOT=
AI_DISALLOW_APPLEBOT_EXTENDED=
AI_DISALLOW_COHERE_AI=
AI_DISALLOW_META_EXTERNALAGENT=

# Sentry error monitoring. All four are optional — the SDK is a no-op without a
# DSN. `NEXT_PUBLIC_SENTRY_DSN` is the browser side; `SENTRY_DSN` is server +
# edge. Use the same DSN for both. `SENTRY_AUTH_TOKEN` + `SENTRY_ORG` +
# `SENTRY_PROJECT` enable source-map upload during production `next build`.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_ENVIRONMENT=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# App API / cron
CRON_SECRET=
# Rate limits — max requests per window per key. Defaults live in
# src/constants/app.constants.ts; set these only to override. See DEVELOPER.md
# for the window (duration) each endpoint uses.
CONTACT_RATE_LIMIT=5          # per IP / 15 min
SUBSCRIBE_RATE_LIMIT=3        # per IP / 15 min
SUBSCRIBE_CONFIRM_RATE_LIMIT=10  # per IP / 15 min
ARTICLES_RATE_LIMIT=60        # per IP / min
SEARCH_RATE_LIMIT=30          # per IP / min
ANALYTICS_VIEW_RATE_LIMIT=120 # per IP / min
HEALTH_RATE_LIMIT=30          # per IP / min
ADMIN_LOGIN_RATE_LIMIT=5      # per IP / 15 min
ADMIN_LOGIN_EMAIL_RATE_LIMIT=10  # per email / hour
ADMIN_WRITE_RATE_LIMIT=60     # per admin user id / min (shared across all writes)
LIST_REVALIDATE_SECONDS=60

# Admin auth hardening — all fail-closed (bad value falls back to the default).
ADMIN_TOKEN_TTL_SECONDS=7200  # session lifetime, default 2h
ADMIN_MAX_LOGIN_ATTEMPTS=5    # account lockout threshold
ADMIN_LOCK_TIME_SECONDS=900   # lockout duration after threshold, default 15m
CONTACT_TO_EMAIL=
# Durable rate-limit store. When set, limits hold across serverless instances
# and restarts (ioredis). Leave empty to fall back to an in-memory Map (dev only;
# a one-time warning is logged in production).
REDIS_URL=
# Header carrying the real client IP, set by your platform/proxy and not
# forgeable by the client. Vercel: x-vercel-forwarded-for. Cloudflare:
# cf-connecting-ip. Leave empty to fall back to x-forwarded-for last hop.
TRUSTED_IP_HEADER=

# Email (Resend) — newsletter double opt-in
# Get a key at https://resend.com. Leave RESEND_API_KEY empty in local dev to
# auto-confirm subscribers and skip the email send.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Kiribé <hello@kiribeonline.com>"

# Figma (local dev / design sync — do not commit real tokens)
FIGMA_FILE_KEY=iBC8YfVwanBDq1nh1VTS9f
FIGMA_ACCESS_TOKEN=
